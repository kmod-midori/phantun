# Copy sections to add instances. Use unique TUN names and address pairs.
config client 'client1'
	option enabled '0'
	option local '127.0.0.1:1234'
	option remote 'vpn.example.com:4567'
	option tun 'phantunc1'
	option tun_local '192.168.200.1'
	option tun_peer '192.168.200.2'
	option ipv4_only '1'
	option log_level 'info'
	# option tun_local6 'fcc8::1'
	# option tun_peer6 'fcc8::2'
	# option handshake_packet '/etc/phantun/handshake.bin'

config server 'server1'
	option enabled '0'
	option local '4567'
	option remote '127.0.0.1:51820'
	option tun 'phantuns1'
	option tun_local '192.168.201.1'
	option tun_peer '192.168.201.2'
	option ipv4_only '1'
	option log_level 'info'
	# option tun_local6 'fcc9::1'
	# option tun_peer6 'fcc9::2'
